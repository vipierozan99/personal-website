{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		// Without this the checker walks node_modules, dist and dist-ssr and runs
		// itself out of memory before it reaches any source file.
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		// The build outputs and node_modules are listed here rather than left to
		// the ignore file above: that one filters the files biome reports on, but
		// the directory walk still descends into them first.
		"includes": [
			"**",
			"!**/tsconfig.*.json",
			"!**/node_modules",
			"!**/dist",
			"!**/dist-ssr",
			"!**/.serena",
			// Generated by @tanstack/router-plugin; formatting it fights the generator.
			"!**/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		// Tabs carry no width of their own, so this is only what biome assumes a
		// tab occupies when deciding where to wrap. .editorconfig says the same
		// thing to the editor; the two must agree or lines wrap at one width and
		// are displayed at another.
		"indentWidth": 2,
		"lineEnding": "lf",
		"useEditorconfig": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"json": {
		"parser": {
			"allowTrailingCommas": true
		}
	},
	"css": {
		"parser": {
			// index.css is Tailwind 4, which drives everything through @theme and
			// @utility. Without this the parser rejects both blocks outright and
			// the rest of the file is never linted or formatted.
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off",
				"noImplicitAnyLet": "off",
				"noConsole": {
					"level": "warn",
					"options": { "allow": ["info", "warn", "error"] }
				}
			},
			"style": {
				"noNonNullAssertion": "off",
				"useSingleVarDeclarator": "off"
			},
			"correctness": {
				"noUnusedImports": "warn",
				"useHookAtTopLevel": "error"
			},
			"nursery": {
				// Keeps Tailwind class strings in one canonical order, so a token
				// refactor like the type/spacing scale shows up as a clean diff.
				"useSortedClasses": {
					"level": "warn",
					"fix": "safe",
					"options": { "functions": ["clsx"] }
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
