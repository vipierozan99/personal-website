{
	"name": "personal-website",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.js && node scripts/headers.js",
		"preview": "vite preview",
		"lint": "biome check .",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest run",
		"knip": "knip",
		"size": "size-limit"
	},
	"dependencies": {
		"@comark/react": "^0.6.1",
		"@tanstack/react-router": "^1.170.21",
		"clsx": "^2.1.1",
		"comark": "^0.6.1",
		"i18next": "^26.3.6",
		"i18next-icu": "^2.4.4",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@formatjs/icu-messageformat-parser": "3.5.16",
		"@size-limit/file": "^13.0.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-plugin": "^1.168.26",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"happy-dom": "^20.11.1",
		"knip": "^6.32.0",
		"size-limit": "^13.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.7.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"size-limit": [
		{
			"name": "app bundle",
			"path": "dist/assets/index-*.js",
			"limit": "90 kB"
		},
		{
			"name": "css",
			"path": "dist/assets/index-*.css",
			"limit": "8 kB"
		},
		{
			"name": "content chunk (en)",
			"path": "dist/assets/site.en-*.js",
			"limit": "4 kB"
		}
	]
}
